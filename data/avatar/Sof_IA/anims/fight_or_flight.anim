# Fight or flight: acute stress. Fast, shallow breathing, eyes wide, brows up and drawn together, quick
# glances (the eyes lead, the head follows), frequent blinks. A hard, reddish light.
# The format is in data\avatar\README.txt.
blend = 0.35

key_light         = 1.30 0.90 0.80
fill_light        = 0.20 0.16 0.22
rim_light         = 0.80 0.28 0.25
ambient           = 0.20 0.15 0.17
background_top    = 0.27 0.09 0.11
background_bottom = 0.08 0.03 0.05

track = body   s   wave 0.010 1.6
track = neck   rx  wave 0.4 1.6 0.25
track = head   rx  hold -2.5
track = head   rx  wave 0.5 0.7
track = head   ry  keys 3.2 vary 0.4  0 0  0.14 7  1.3 7  1.44 -6  2.9 -6  3.05 0
track = gaze*  tx  keys 3.2 vary 0.4  0 0  0.06 0.022  1.3 0.022  1.36 -0.022  2.9 -0.022  2.98 0
track = eye*   sy  hold 1.16
track = eye*   sy  keys 2.6 vary 0.4  0 1  2.35 1  2.43 0.1  2.53 1
track = brow*  ty  hold 0.035
track = brow.L rz  hold -9
track = brow.R rz  hold 9
track = jaw    ty  hold -0.010
